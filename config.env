# ==== fire (LinyxKernel-OC) ====
KERNEL_SOURCE=https://github.com/Linyx9/android_kernel_xiaomi_fire
KERNEL_SOURCE_BRANCH=Linyx-OC
KERNEL_ARCH=arm64

# TODO: confirm the real defconfig filename in arch/arm64/configs/
# workflow looks for arch/arm64/configs/${DEVICE}_defconfig -> fire_defconfig
# if the actual file has a different name, either rename it in the repo
# or change DEVICE in the workflow env to match the defconfig prefix.

# TODO: confirm actual output image name (Image.gz-dtb vs Image.gz)
KERNEL_IMAGE_NAME=Image.gz-dtb

# TODO: confirm whether a separate dtbo.img is produced by this build
NEED_DTBO=true

ADD_LOCALVERSION_TO_FILENAME=true
ENABLE_CCACHE=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# Clang - AOSP prebuilt; adjust branch/version to match what LinyxKernel-OC
# was built with locally (check your local build.sh / README for the exact
# clang version used, so CI output matches your known-good local build)
USE_CUSTOM_CLANG=false
CLANG_BRANCH=main
CLANG_VERSION=r547379
